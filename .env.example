# Vercel + Turso environment variables
# Copy to .env.local for local development after the real Turso database is created.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
# Optional when Kakao Client Secret is disabled in the Kakao console.
KAKAO_CLIENT_SECRET=
KAKAO_SCOPE=profile_nickname
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
TOSS_SUBSCRIPTION_AMOUNT=9900
TOSS_SUBSCRIPTION_ORDER_NAME=zezari 월 구독
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:general@zezari.com
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
PUBLIC_APP_URL=https://zezari.family
ADMIN_EMAILS=general@zezari.com,soonsuboy10@gmail.com

# Signup verification (Resend email is active; legacy SMS remains disabled)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=zezari.family
# Optional explicit override. When empty, auth@RESEND_EMAIL_DOMAIN is used.
RESEND_FROM_EMAIL=제자리 <auth@zezari.family>
EMAIL_DEV_BYPASS_CODE=
SIGNUP_SMS_VERIFICATION_ENABLED=false
SMS_PROVIDER=generic
SMS_API_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_NO=
SMS_DEV_BYPASS_CODE=

# Meta Marketing API (server only)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Required for ad creative publishing. Connect this Facebook Page to the ad account.
META_PAGE_ID=
META_API_VERSION=v23.0
META_CAMPAIGN_OBJECTIVE=OUTCOME_AWARENESS
META_OPTIMIZATION_GOAL=REACH

# Bizcall 050 safe-number integration (server only)
# The standard API host defaults to https://api.050bizcall.co.kr.
# Override the base URL only when Delphicom/Bizcall issues a contract-specific host.
# The Interface ID is a separate code issued by Delphicom; it is not the portal login ID.
BIZCALL_ENABLED=true
BIZCALL_API_BASE_URL=https://api.050bizcall.co.kr
BIZCALL_INTERFACE_ID=
BIZCALL_TIMEOUT_MS=8000

# Subject photos are currently stored as image data URLs in Turso.
# Keep uploads small; the app enforces a 1MB limit per photo.
